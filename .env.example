# local | aws
THYME_ENV=local
THYME_DEFAULT_USER_ID=local-dev

# Local laptop testing (590R-AI labs style)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: Fernet key for encrypting BYOK secrets.
# If empty, a key is generated at backend/data/.fernet_key (gitignored).
