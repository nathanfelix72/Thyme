# local | aws
THYME_ENV=local
THYME_DEFAULT_USER_ID=local-dev
# false (default) = Cognito login required for API. true = anonymous local-dev (tests only).
THYME_ALLOW_ANON=false

# Local laptop testing (590R-AI labs style)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: Fernet key for encrypting BYOK secrets.
# If empty, a key is generated at backend/data/.fernet_key (gitignored).
# THYME_SECRETS_KEY=

# Team/dev fallback keys (optional — prefer per-user BYOK in Settings UI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LangSmith (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=thyme

# Cognito (AWS infra phase 1 — already created)
AWS_REGION=us-west-1
USER_SECRETS_TABLE=thyme-user-secrets
RECIPES_TABLE=thyme-recipes
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# LLM Phase 1 RAG — local Chroma + one Tavily web search call
# CHROMA_DIR=backend/data/chroma
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TAVILY_API_KEY=
# HF_TOKEN=   # optional; only helps Hugging Face model *downloads*, not search speed

# Google Calendar — optional. Prefer one-time setup on the Plan page UI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET==
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/calendar/google/callback
# FRONTEND_ORIGIN=http://localhost:5173
# Production API (EC2) uses FRONTEND_ORIGIN=https://dv5md9hmzm76i.cloudfront.net via deploy.

# Future: Plaid (budget module)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
