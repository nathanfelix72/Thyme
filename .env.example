# Team/dev fallback keys (optional — prefer per-user BYOK in Settings UI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LangSmith (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=thyme

# Cognito (phase 1 — already created)
